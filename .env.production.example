# .env.production.example — Kopieren als .env.production und im Hosting-Provider setzen.
# In Vercel unter Project Settings → Environment Variables eintragen.

# Database (PostgreSQL) — wird auch als DATABASE_URL von Vercel Postgres erkannt
SQL_DATABASE_URL="postgresql://user:password@host:5432/boardgametools"

# NextAuth — muss die finale Live-URL sein
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="mindestens-32-zeichen-langes-random-secret"

# Öffentliche App-URL (für absolute Links, E-Mails, iOS Deep Links)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# BGG API (optional — leer lassen wenn nicht benoetigt)
BGG_API_URL="https://boardgamegeek.com/xmlapi2"
BGG_AUTH_TOKEN=""

# Password reset / mailer
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
PASSWORD_RESET_SENDER="BoardGameTools <no-reply@your-app.vercel.app>"
PASSWORD_RESET_TOKEN_TTL_MINUTES="60"

# Vercel Blob / Uploads (erforderlich fuer Produktion — ohne werden Uploads abgelehnt)
BLOB_READ_WRITE_TOKEN=""

# Upstash Redis für Rate-Limiting & Caching (optional — ohne In-Memory-Fallback)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Apple Sign In (optional)
APPLE_CLIENT_ID=""

# Apple Push Notifications (optional)
APNS_ENABLED="false"
APNS_PRODUCTION="false"
APNS_TEAM_ID=""
APNS_KEY_ID=""
APNS_SIGNING_KEY=""
APNS_TOPIC="com.boardgametools.ios"
