{
  "name": "boardgametools",
  "version": "0.50.17",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "dev:webpack": "NODE_OPTIONS='--max-old-space-size=4096' next dev --webpack",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:deploy": "node scripts/prisma-deploy.js",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:related": "vitest run --reporter=default",
    "test:e2e": "codeceptjs run --steps --config tests/e2e/codecept.conf.ts",
    "test:e2e:headless": "HEADLESS=true codeceptjs run --steps --config tests/e2e/codecept.conf.ts",
    "analyze": "ANALYZE=true next build",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "security-check": "bash scripts/security-check.sh",
    "security-check:only": "bash scripts/security-check.sh --only",
    "security-check:strict": "bash scripts/security-check.sh --strict",
    "security-check:json": "bash scripts/security-check.sh --json",
    "security-check:fast": "bash scripts/security-check.sh --no-audit",
    "security-check:list": "bash scripts/security-check.sh --list",
    "pipeline:check": "bash scripts/check-pipeline.sh",
    "review-evaluate": "node scripts/review-evaluate.mjs --apply",
    "review-evaluate:json": "node scripts/review-evaluate.mjs --json",
    "review-evaluate:strict": "node scripts/review-evaluate.mjs --apply --strict",
    "review-evaluate:report": "node scripts/review-evaluate.mjs",
    "review-evaluate:regression": "node scripts/review-evaluate.mjs --apply --fail-on-regression",
    "backup:prod": "bash scripts/backup-prod-db.sh",
    "release:build": "npm run prisma:deploy && npm run build",
    "test:ios:contracts": "bash scripts/test-ios-contracts.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "apns2": "^12.2.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "html5-qrcode": "^2.3.8",
    "jose": "^5.10.0",
    "lucide-react": "^1.30.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.2.1",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@codeceptjs/configure": "^1.0.6",
    "@next/bundle-analyzer": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "codeceptjs": "^4.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "prisma": "^7.10.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "vitest related --run"
    ]
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.4",
      "serialize-javascript": "^7.0.5"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.18"
    },
    "codeceptjs": {
      "uuid": "^11.1.1",
      "axios": "^1.19.0"
    },
    "undici@>=6 <7": "^6.29.1",
    "zod@>=4 <4.6.6": "^4.6.7",
    "js-yaml@>=4 <5": "^4.3.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
